{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zitadel Management Applications Identity Providers API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Identity Providers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Zitadel List Identity Providers",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}.zitadel.cloud/management/v1/idps/_search"
          },
          "docs": "List all configured external identity providers for the organization."
        }
      ]
    }
  ],
  "bundled": true
}